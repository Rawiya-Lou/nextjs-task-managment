{
  "name": "nextjs-task-managment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude **/*.integration.test.ts",
    "test:watch": "vitest",
    "test:integration": "env-cmd -f .env.test bash -c \"npx prisma generate && npx prisma db push && npx vitest run --project=integration\"",
    "test:coverage": "vitest run --project=unit"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@testing-library/user-event": "^14.6.5",
    "dotenv": "^17.4.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "env-cmd": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^29.1.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "vitest-mock-extended": "^5.1.1"
  },
  
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
